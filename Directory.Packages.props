    <PackageVersion Include="LibGit2Sharp" Version="0.31.0" />
    <PackageVersion Include="Material.Icons.Avalonia" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Build" Version="17.13.25" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.9.1" />
