    <PackageVersion Include="Avalonia.Desktop" Version="11.3.8" />
    <PackageVersion Include="Avalonia.iOS" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Browser" Version="11.3.6" />
    <PackageVersion Include="Avalonia.Android" Version="11.3.6" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="11.3.8" />
    <PackageVersion Include="DialogHost.Avalonia" Version="0.9.3" />
    <PackageVersion Include="Dock.Avalonia" Version="11.3.6.5" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="11.3.6.5" />
    <PackageVersion Include="Dock.Model.Extensions.DependencyInjection" Version="11.3.6.5" />
    <PackageVersion Include="Dock.Model.ReactiveUI" Version="11.3.6.5" />
